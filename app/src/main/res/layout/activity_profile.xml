<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainProfileLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071018">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/llProfileTopBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#071018"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnProfileBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:id="@+id/profileHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/llProfileTopBar"
        android:background="#1F2E3D" />

    <!-- Error Banner with Retry -->
    <LinearLayout
        android:id="@+id/llProfileError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/profileHeaderDivider"
        android:background="#111827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvProfileErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Could not load latest profile"
            android:textColor="#EF4444"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryProfile"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Retry"
            android:textColor="#00D4FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Shimmer Loading Container -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llProfileError"
        android:visibility="gone"
        app:shimmer_auto_start="true"
        app:shimmer_base_color="#111827"
        app:shimmer_highlight_color="#1F2E3D">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/bg_shimmer_placeholder_dark" />

            <View
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_placeholder_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_shimmer_placeholder_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_placeholder_dark" />

            <View
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_placeholder_dark" />

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvProfileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llProfileError"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <!-- Avatar & Change Photo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfilePhoto"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:background="#111827"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_user"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#1F2E3D"
                        app:strokeWidth="2dp" />

                    <ProgressBar
                        android:id="@+id/pbUploadPhoto"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="#00D4FF"
                        android:visibility="gone" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePhoto"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Change photo"
                    android:textColor="#00D4FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Editable Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Name"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2E3D"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etProfileName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="12dp"
                    android:hint="Your full name"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Read-only Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Email"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2E3D"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:drawableStart="@drawable/ic_mail"
                    android:drawablePadding="12dp"
                    android:focusable="false"
                    android:hint="Email address"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingHorizontal="16dp"
                    android:textColor="#9CA3AF"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Phone Number Header with Prompt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phone Number"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPhonePrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add your phone number"
                    android:textColor="#00D4FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfilePhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#111827"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2E3D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="16dp"
                        android:src="@drawable/ic_call"
                        app:tint="#9CA3AF" />

                    <TextView
                        android:id="@+id/tvCountryCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="+91"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="#1F2E3D" />

                    <EditText
                        android:id="@+id/etProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="10-digit number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingEnd="16dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6B7280"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please enter a valid 10-digit phone number"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:text="Save"
                android:textColor="#071018"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#00D4FF"
                app:cornerRadius="16dp" />

            <!-- Log Out Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutProfile"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#111827"
                android:text="Log out"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#1F2E3D"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
