<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitSync"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".screens.Nutrition.AiCoachActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".screens.Nutrition.FoodSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />


        <activity
            android:name=".screens.Nutrition.NutritionActivity"
            android:exported="false" />


        <activity
            android:name=".screens.workout.WorkoutLoadingActivity"
            android:exported="false" />
        <activity
            android:name=".screens.workout.CheckInActivity"
            android:exported="false" />
        <activity
            android:name=".screens.workout.ExerciseDetailActivity"
            android:exported="false" />
        <activity
            android:name=".screens.workout.WorkoutDetailActivity"
            android:exported="false" />


        <activity
            android:name=".screens.MainActivity"
            android:exported="false" />
        <activity
            android:name=".screens.AnalysisActivity"
            android:exported="false" />
        <activity
            android:name=".screens.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".screens.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".screens.SignupActivity"
            android:exported="false" />
        <activity
            android:name=".screens.LoginActivity"
            android:exported="false" />


        <activity
            android:name=".screens.Splash"
            android:exported="true"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>