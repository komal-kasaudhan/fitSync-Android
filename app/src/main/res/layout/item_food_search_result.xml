<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardFoodItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#0D1926"
    app:cardCornerRadius="16dp"
    app:strokeColor="#1A2E44"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- 🥣 CATEGORY ICON / THUMBNAIL -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#162536"
            app:cardCornerRadius="12dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivFoodCategoryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#8B5CF6" />
        </com.google.android.material.card.MaterialCardView>

        <!-- 📝 FOOD DETAILS (NAME & SERVING SIZE) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toStartOf="@id/llMacroContainer"
            android:layout_toEndOf="@id/cardIconContainer"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFoodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Paneer Butter Masala" />

            <TextView
                android:id="@+id/tvFoodServingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                tools:text="1 Serving (150g) • Indian Cuisine" />
        </LinearLayout>

        <!-- 📊 MACRO BADGES (CALORIES & PROTEIN) -->
        <LinearLayout
            android:id="@+id/llMacroContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:layout_toStartOf="@id/btnAddFoodItem"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="320 kcal" />

            <!-- Protein Tag Pill -->
            <TextView
                android:id="@+id/tvItemProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="#16382B"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#10B981"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="18g Prot" />
        </LinearLayout>

        <!-- ➕ ADD BUTTON -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnAddFoodItem"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="#8B5CF6"
            app:cardCornerRadius="10dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_input_add"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>