<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

<!-- Base Dark Background -->
<item>
    <shape>
        <solid android:color="#030B1A"/>
    </shape>
</item>

<!-- Top Left Glow -->
<item
    android:top="-180dp"
    android:left="-180dp">
    <shape android:shape="oval">
        <size
            android:width="360dp"
            android:height="360dp"/>
        <solid android:color="#2200D4FF"/>
    </shape>
</item>

<!-- Bottom Right Glow -->
<item
    android:gravity="bottom|right"
    android:right="-180dp"
    android:bottom="-180dp">
    <shape android:shape="oval">
        <size
            android:width="360dp"
            android:height="360dp"/>
        <solid android:color="#2200D4FF"/>
    </shape>
</item>

</layer-list>