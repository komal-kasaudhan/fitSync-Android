<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

<!-- Dark background -->
<item>
    <shape>
        <solid android:color="#030B1A"/>
    </shape>
</item>

<!-- Top Left Glow -->
<item
    android:width="300dp"
    android:height="300dp"
    android:gravity="top|left">
    <shape android:shape="oval">
        <gradient
            android:type="radial"
            android:gradientRadius="150dp"
            android:startColor="#4000D4FF"
            android:endColor="#0000D4FF"/>
    </shape>
</item>

<!-- Bottom Right Glow -->
<item
    android:width="300dp"
    android:height="300dp"
    android:gravity="bottom|right">
    <shape android:shape="oval">
        <gradient
            android:type="radial"
            android:gradientRadius="150dp"
            android:startColor="#4000D4FF"
            android:endColor="#0000D4FF"/>
    </shape>
</item>

</layer-list>