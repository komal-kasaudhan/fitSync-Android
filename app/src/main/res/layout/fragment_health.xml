<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    tools:context=".screens.fragments.Onboarding.HealthFragment"
    android:background="@color/dark_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

    <TextView
        android:id="@+id/titlemain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_cyan"
        android:textSize="35sp"
        android:text="Health Status"
        android:textStyle="bold"
        android:layout_marginTop="10dp">

    </TextView>

    <TextView
        android:id="@+id/titlesub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_gray_blue"
        android:text="Finalising your bio-profile for precision AI caliberation."
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        >

    </TextView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/cyan"
        android:textSize="14sp"
        android:text="Medical Conditions"
        android:letterSpacing="0.02"
        android:textStyle="bold"
        android:layout_marginTop="22dp">

    </TextView>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAsthma"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginRight="15dp"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_white_crisp"
                    android:text="Asthma">

                </TextView>

            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiabetes"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_white_crisp"
                    android:text="Diabetes">

                </TextView>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeartCondition"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginRight="15dp"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_white_crisp"
                    android:text="Heart Condition">

                </TextView>

            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHypertension"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/text_white_crisp"
                    android:text="Hypertension">

                </TextView>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNoneCondition"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="15dp"
            android:textColor="@color/text_white_crisp"
            android:text="Hypertension"
            android:background="@drawable/bg_signup"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#203040">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_white_crisp"
                android:text="None/No Known Condition">

            </TextView>

        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:text="Other / Specific Notes "
            android:letterSpacing="0.02"
            android:textStyle="bold"
            android:layout_marginTop="22dp">

        </TextView>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="none">

            <EditText
                android:id="@+id/etSpecialNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top"
                android:padding="16dp"
                android:hint="Any additional details or recent surgeries..."
                android:textColor="@color/text_white_crisp"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:background="@drawable/bg_signup"
                android:backgroundTint="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040"/>

        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:text="Physical Limitation "
            android:letterSpacing="0.02"
            android:textStyle="bold"
            android:layout_marginTop="22dp">

        </TextView>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:hintEnabled="false"
            app:boxBackgroundMode="none">

            <EditText
                android:id="@+id/etPhysicalLimitation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:gravity="top"
                android:padding="16dp"
                android:hint="Injuries, range of motion issues, etc.."
                android:textColor="@color/text_white_crisp"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:backgroundTint="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040"
                android:background="@drawable/bg_signup" />

        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_signup"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#203040"
            >
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHealthClearence"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:cardBackgroundColor="#101827"
                    app:cardCornerRadius="12dp"
                    android:layout_marginRight="20dp"
                    android:background="@drawable/small_box"
                    app:strokeWidth="1dp"
                    app:strokeColor="#203040" >
                </com.google.android.material.card.MaterialCardView>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_white_crisp"
                        android:text="Health Clearence"
                        android:textStyle="normal"
                        android:textSize="18sp">

                    </TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_gray_blue"
                        android:text="I confirm that I have been cleared by a medical professional for physical activity and bio-hacking protocols."
                        android:textStyle="normal"
                        android:layout_marginTop="8dp"
                        android:textSize="13sp">

                    </TextView>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:textColor="@color/text_white_crisp"
            android:text="Hypertension"
            android:background="@drawable/bg_signup"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="#203040">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/brand_cyan"
                    android:layout_marginRight="10dp"
                    android:layout_gravity="center">

                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your data is encrypted using end-to-end medical grade security."
                    android:textColor="@color/brand_cyan">

                </TextView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>