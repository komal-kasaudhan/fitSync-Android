<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".screens.Splash"
    android:background="@color/dark_bg">

    <View
        android:id="@+id/glowCircle"
        android:layout_width="290dp"
        android:layout_height="290dp"
        android:background="@drawable/ring"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"/>

    <ImageView
        android:id="@+id/logoIcon"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/screen3"
        app:layout_constraintBottom_toBottomOf="@id/glowCircle"
        app:layout_constraintStart_toStartOf="@id/glowCircle"
        app:layout_constraintTop_toTopOf="@id/glowCircle"
        app:layout_constraintEnd_toEndOf="@id/glowCircle"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:text="FitSync"
        android:textColor="#4DEBFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/glowCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-condensed-light"
        android:letterSpacing="0.1"
        android:textColor="#A0B2C6"
        android:textSize="10sp"
        android:text="YOUR FITNESS JOURNEY,PERSONALIZED"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:id="@+id/loadingBar"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:layout_marginBottom="12dp"
        android:background="#4DEBFF"
        app:layout_constraintBottom_toTopOf="@id/syncingText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/syncingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif"
        android:text="Syncing Health Data..."
        android:textColor="#5F758E"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>