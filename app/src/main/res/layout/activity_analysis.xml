<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#101827"
android:gravity="center"
android:padding="30dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">


    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/analysisLoader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorSize="80dp"
        app:trackThickness="6dp"
        app:indicatorColor="@color/brand_cyan"
        app:trackColor="#203040" />


    <TextView
        android:id="@+id/tvAnalysisStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Analyzing your bio-profile data..."
        android:textColor="@color/brand_cyan"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.03" />

    <TextView
        android:id="@+id/tvAnalysisSubStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="FitSync neural engine calibrating metrics for precision planning."
        android:textColor="@color/text_gray_blue"
        android:textSize="14sp"
        android:gravity="center" />

</LinearLayout>

</RelativeLayout>