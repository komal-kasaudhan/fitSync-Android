<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_dark_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap to Rate Your Experience"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <!-- 5 Star Rating Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStar1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_star"
            app:tint="@color/gym_gold" />

        <ImageView
            android:id="@+id/ivStar2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_star"
            app:tint="@color/gym_gold" />

        <ImageView
            android:id="@+id/ivStar3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_star"
            app:tint="@color/gym_gold" />

        <ImageView
            android:id="@+id/ivStar4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_star"
            app:tint="@color/gym_gold" />

        <ImageView
            android:id="@+id/ivStar5"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:src="@drawable/ic_star"
            app:tint="@color/gym_gold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Your Review"
        android:textColor="@color/text_gray_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etReviewComment"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_input"
        android:gravity="top|start"
        android:hint="Tell us about the equipment, cleanliness, staff, and overall experience..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_gray_blue"
        android:textSize="13sp" />

</LinearLayout>
