<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardWeeklyDay"
    android:layout_width="110dp"
    android:layout_height="142dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1F2E3D"
    app:cardBackgroundColor="#1C2638">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <!-- Completed Check Badge -->
        <ImageView
            android:id="@+id/ivDayCompletedBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/ic_check"
            app:tint="#10B981"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MON"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivDayIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginVertical="8dp"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#00D4FF" />

            <TextView
                android:id="@+id/tvDayFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Lower Body"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDayMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="45m • 240 kcal"
                android:textColor="#6B7280"
                android:textSize="9sp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
