<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_dark_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlanHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Membership Plan"
                android:textColor="@color/gym_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchPlanActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Active"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/btnDeletePlan"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/error" />
        </LinearLayout>

        <EditText
            android:id="@+id/etPlanName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search_input"
            android:hint="Plan Name (e.g. Monthly Elite, Day Pass) *"
            android:paddingHorizontal="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spPlanType"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="8dp" />

            <EditText
                android:id="@+id/etPlanDuration"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_search_input"
                android:hint="Duration (days) *"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPlanPrice"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_search_input"
                android:hint="Price (₹) *"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPlanMrp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_search_input"
                android:hint="MRP (₹ optional)"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPlanInclusions"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="2"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_search_input"
                android:hint="Inclusions (Cardio, Weights, Steam)"
                android:paddingHorizontal="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPlanFreezeDays"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_search_input"
                android:hint="Freeze Days"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:text="0"
                android:textColor="@color/white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
