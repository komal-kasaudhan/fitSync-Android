<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
xmlns:tools="http://schemas.android.com/tools"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:fillViewport="true"
tools:context=".screens.fragments.Onboarding.GoalFragment"
android:background="@color/dark_bg">
    <LinearLayout
        android:id="@+id/goalLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32dp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:text="Your Goals"
        android:textStyle="bold"
        android:layout_marginTop="18dp">

    </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18dp"
            android:layout_gravity="center"
            android:textColor="@color/text_gray_blue"
            android:text="Define your biological trajectory"
            android:textStyle="normal"
            android:layout_marginTop="10dp">

        </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIMARY OBJECTIVE"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:textColor="@color/hologram_line">
        </TextView>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLoseWeight"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginRight="15dp"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                android:background="@drawable/bg_signup"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_local_fire_department"
                        app:tint="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_gravity="center">
                    </ImageView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="LOSE WEIGHT"
                        android:letterSpacing="0.05"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        >

                    </TextView>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBuildMuscle"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040"
                android:background="@drawable/bg_signup">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_fitness_center"
                        app:tint="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_gravity="center">
                    </ImageView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="BUILD MUSCLE"
                        android:letterSpacing="0.05"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        >

                    </TextView>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:weightSum="2">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStayFit"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:layout_marginRight="15dp"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_sports"
                        app:tint="@color/white"
                        android:layout_marginBottom="10dp"
                        android:layout_gravity="center">
                    </ImageView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="STAY FIT"
                        android:letterSpacing="0.05"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        >

                    </TextView>
                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerformance"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:background="@drawable/bg_signup"
                app:cardBackgroundColor="#101827"
                app:cardCornerRadius="12dp"
                app:strokeWidth="1dp"
                app:strokeColor="#203040">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_sports"
                    app:tint="@color/white"
                    android:layout_marginBottom="10dp"
                    android:layout_gravity="center">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="PERFORMANCE"
                    android:letterSpacing="0.05"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    >

                </TextView>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1F2E3D"
            app:strokeWidth="1dp"
            android:background="@drawable/bg_signup">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top Title Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET WEIGHT"
                        android:textColor="#8A99AD"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_monitor_weight"
                        app:tint="#203040" />
                </RelativeLayout>

                <!-- Vertical Sliding Window Context -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTargetWeight"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="50dp"
                        android:paddingBottom="50dp"
                        android:overScrollMode="never" />

                    <!-- Static Center Metric 'kg' Indicator Unit Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="80dp"
                        android:text="kg"
                        android:textColor="@color/brand_cyan"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Dynamic Horizontal Line Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#1F2E3D" />

                <!-- AI Smart Calculated Optimal Badge Footer Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CALCULATED OPTIMAL"
                        android:textColor="#8A99AD"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvAiOptimalWeight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="74.5"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- AI Floating Bot Bubble Icon Button -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            app:cardBackgroundColor="#0D2026"
                            app:cardCornerRadius="8dp"
                            app:strokeColor="#163840"
                            app:strokeWidth="1dp">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_smart_toy"
                                app:tint="@color/brand_cyan" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="#101827"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1F2E3D"
            app:strokeWidth="1dp"
            android:background="@drawable/bg_signup">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top Title Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET TIMELINE"
                        android:textColor="#8A99AD"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_event"
                        app:tint="#203040" />
                </RelativeLayout>

                <!-- Vertical Sliding Window Context -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="12dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="48dp"
                        android:background="#1F2E3D" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- ⏱️ Left Column: Numeric Value Spinner RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTimelineValue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:paddingTop="48dp"
                            android:paddingBottom="48dp"
                            android:overScrollMode="never" />

                        <!-- ⏱️ Right Column: Time Unit Spinner RecyclerView (Days, Weeks, Months, Years) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTimelineUnit"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:paddingTop="48dp"
                            android:paddingBottom="48dp"
                            android:overScrollMode="never" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="48dp"
                        android:background="#1F2E3D" />
                </FrameLayout>


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

</LinearLayout>



</ScrollView>