<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#071018">

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/llDetailLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#071018"
        android:elevation="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#00D4FF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading day's training program..."
            android:textColor="#E5E7EB"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Error State -->
    <LinearLayout
        android:id="@+id/llDetailError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#071018"
        android:padding="24dp"
        android:elevation="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="#EF4444" />

        <TextView
            android:id="@+id/tvDetailErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Could not load today's workout"
            android:textColor="#E5E7EB"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Retry"
            android:textColor="#071018"
            android:backgroundTint="#00D4FF"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Fixed Bottom Action Bar (Hidden on Rest Days) -->
    <LinearLayout
        android:id="@+id/bottomActionDeck"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#0C1420"
        android:layout_alignParentBottom="true"
        android:elevation="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:layout_marginEnd="6dp"
            android:text="Skip Today"
            android:textColor="#EF4444"
            android:textStyle="bold"
            android:textSize="13sp"
            android:backgroundTint="#162536"
            app:strokeColor="#EF4444"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishWorkout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_marginStart="6dp"
            android:text="Finish Workout  ✓"
            android:textColor="#071018"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="#00D4FF"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvWorkoutContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomActionDeck"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Header Hero Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/ivHeroWorkoutImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/girl_dumbell"
                    android:scaleType="centerCrop" />

                <!-- Gradient Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#99071018" />

                <!-- Back Navigation Button -->
                <ImageView
                    android:id="@+id/btnDetailBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="16dp"
                    android:background="#660C1420"
                    android:padding="10dp"
                    android:src="@drawable/arrow_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentBottom="true"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDaySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TODAY'S TRAINING"
                        android:textColor="#00D4FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvWorkoutTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chest + Triceps"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <!-- Header Chips: Duration, Intensity, Calories -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="⏱ 45 min"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            app:chipBackgroundColor="#111827"
                            app:strokeColor="#1F2E3D"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipIntensity"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:text="🔥 Medium"
                            android:textColor="#00D4FF"
                            android:textSize="11sp"
                            app:chipBackgroundColor="#111827"
                            app:strokeColor="#1F2E3D"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="6dp"
                            android:text="⚡ 280 kcal"
                            android:textColor="#19F5B0"
                            android:textSize="11sp"
                            app:chipBackgroundColor="#111827"
                            app:strokeColor="#1F2E3D"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <!-- 2. Required Equipment Row for the whole workout -->
            <LinearLayout
                android:id="@+id/llRequiredEquipmentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQUIRED EQUIPMENT ⚙️"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cgRequiredEquipment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:chipSpacing="8dp" />
            </LinearLayout>

            <!-- Rest Day Full View (Visible ONLY when isRestDay == true) -->
            <LinearLayout
                android:id="@+id/llRestDayView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#0D1A26"
                    app:cardCornerRadius="20dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#172F47">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/ic_check"
                            app:tint="#19F5B0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Rest &amp; Muscle Recovery"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.3"
                            android:text="No intense resistance training scheduled today. Recovery is when your muscles rebuild, glycogen stores replenish, and connective tissues adapt."
                            android:textColor="#9CA3AF"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="16dp"
                            android:background="#1F2E3D" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="RECOVERY PROTOCOL 🧘"
                            android:textColor="#00D4FF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.3"
                            android:text="• Drink 3.0L+ of water to assist cellular recovery\n• Maintain protein intake (0.8-1g per lb) for repair\n• Perform light 10-minute mobility or walking\n• Prioritize 7-8 hours of quality sleep tonight"
                            android:textColor="#E5E7EB"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Training Day Container (Hidden on Rest Days) -->
            <LinearLayout
                android:id="@+id/llTrainingDayContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 3. Warm-up Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌀 Warm-up"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvWarmupCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="4 exercises • 5 mins"
                            android:textColor="#36A8FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWarmup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <!-- 4. Today's Workout Main Exercises Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏋️ Today's Workout"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvExerciseCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="6 exercises"
                            android:textColor="#00D4FF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvExercises"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>

                <!-- 5. Cool-down Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧘 Cool-down &amp; Stretch"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCooldownCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="4 stretches"
                            android:textColor="#19F5B0"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCooldown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>