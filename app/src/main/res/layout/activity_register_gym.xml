<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnRegisterBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:src="@drawable/arrow_back"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvRegisterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Register Your Gym"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Rejection banner if rejected -->
            <TextView
                android:id="@+id/tvRejectionBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_search_input"
                android:padding="12dp"
                android:text="Application needs corrections. Update details below."
                android:textColor="@color/status_rejected"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Basic Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="1. BASIC INFORMATION"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etGymName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:hint="Gym Name *"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_gray_blue"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etGymDescription"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_input"
                android:gravity="top|start"
                android:hint="Description (Facilities, equipment, vibe)"
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_gray_blue"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etGymPhone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_search_input"
                android:hint="Contact Phone Number *"
                android:inputType="phone"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_gray_blue"
                android:textSize="14sp" />

            <!-- Address & Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="2. LOCATION &amp; ADDRESS"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etGymAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:hint="Street Address *"
                android:paddingHorizontal="14dp"
                android:textColor="@color/white"
                android:textColorHint="@color/text_gray_blue"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etGymCity"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="City *"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_gray_blue"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etGymPincode"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Pincode"
                    android:inputType="number"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_gray_blue"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Coordinate Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUseGps"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Use GPS"
                    android:textColor="@color/gym_accent"
                    app:icon="@drawable/ic_location"
                    app:iconTint="@color/gym_accent"
                    app:strokeColor="@color/gym_card_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickOnMap"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Pick on Map"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_map"
                    app:iconTint="@color/gym_accent"
                    app:strokeColor="@color/gym_card_border" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCoordinatesDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Coordinates: Lat 23.6693, Lng 86.1511 (Sector 4, Bokaro)"
                android:textColor="@color/gym_accent"
                android:textSize="12sp" />

            <!-- Photo Upload Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="3. GYM PHOTO"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivGymPhotoPreview"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gym" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnUploadPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/gym_card_border"
                        android:text="Select Photo"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvPhotoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="No photo selected"
                        android:textColor="@color/text_gray_blue"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Amenities -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="4. AMENITIES"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRegisterAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacing="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegAc"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="AC" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegCardio"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Cardio" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegWeights"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Weights" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegLockers"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Lockers" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegParking"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parking" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegWifi"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WiFi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRegShower"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shower" />
            </com.google.android.material.chip.ChipGroup>

            <!-- 5. Opening Hours -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5. OPENING HOURS &amp; TIMINGS"
                    android:textColor="@color/text_gray_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyMondayAll"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Copy Mon to all"
                    android:textColor="@color/gym_accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Configure open/close shifts per day. Add split timings (morning &amp; evening)."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutDaysScheduleContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 6. Holidays -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="6. HOLIDAYS &amp; CLOSURES"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Add dates when the gym will be closed (e.g. festivals, maintenance)."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutHolidaysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddHoliday"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:text="+ Add Holiday / Closure"
                android:textColor="@color/gym_accent"
                android:textSize="13sp"
                app:strokeColor="@color/border" />

            <!-- 7. Membership Plans -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="7. MEMBERSHIP PLANS"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="At least 1 active plan required (Day Pass, Weekly, Monthly, etc.)"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutPlansContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPlan"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:text="+ Add Membership Plan"
                android:textColor="@color/gym_accent"
                android:textSize="13sp"
                app:strokeColor="@color/border" />

            <!-- 8. Slot Capacity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="8. CAPACITY PER SLOT"
                android:textColor="@color/text_gray_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/etCapacityPerSlot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_input"
                android:hint="Maximum members per hour slot (default 20)"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:text="20"
                android:textColor="@color/white"
                android:textColorHint="@color/text_gray_blue"
                android:textSize="14sp" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnSubmitRegistration"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/gym_accent"
                android:text="Submit Gym Application"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
