<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_wlc"
    tools:context=".screens.WelcomeActivity">

    <!-- ===================== -->
    <!-- Vertical Guidelines -->
    <!-- ===================== -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.92" />



    <!-- ===================== -->
    <!-- Top Card -->
    <!-- ===================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardup"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:elevation="10dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_wlc"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FitSync"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>


        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- ===================== -->
    <!-- Welcome -->
    <!-- ===================== -->

    <TextView
        android:id="@+id/wlc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Welcome to FitSync"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardup"
        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide"/>


    <TextView
        android:id="@+id/wlcsubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Discover personalized fitness and nutrition plans designed specifically for your goals."
        android:textColor="@color/hologram_line"
        android:textSize="17sp"
        app:layout_constraintTop_toBottomOf="@id/wlc"
        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide"/>


    <!-- ===================== -->
    <!-- Hologram -->
    <!-- ===================== -->

    <FrameLayout
        android:id="@+id/hologramContainer"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toBottomOf="@id/wlcsubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Outer Ring -->

        <View
            android:id="@+id/ringOuter"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_gravity="center"
            android:background="@drawable/ring_outer"/>

        <!-- Middle Ring -->

        <View
            android:id="@+id/ringMiddle"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/ring_middle"/>

        <!-- Inner Ring -->

        <View
            android:id="@+id/ringInner"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/ring_inner"/>

        <!-- Image -->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/hologramImage"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/hologram_body"
            app:shapeAppearanceOverlay="@style/CircleImage"/>

    </FrameLayout>


    <!-- ===================== -->
    <!-- Button -->
    <!-- ===================== -->

    <FrameLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide">

        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:alpha="0.6"
            android:background="@drawable/button_glow"/>

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:background="@drawable/start_bg"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="@color/btn_glow_border"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>