<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnReviewBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:src="@drawable/arrow_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReviewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entity Review"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FitSync Admin Review"
                        android:textColor="@color/text_gray_blue"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReviewStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_rounded"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="PENDING"
                    android:textColor="@color/status_pending"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Medical Claims Warning Banner -->
            <LinearLayout
                android:id="@+id/layoutMedicalClaimsWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_gym_card"
                android:backgroundTint="#2D1111"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Banned Medical Claims Flag"
                    android:textColor="@color/gym_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMedicalClaimsReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Banned medical claim keywords detected"
                    android:textColor="@color/text_white_crisp"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Image Thumbnail -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_dark_bg">

                <ImageView
                    android:id="@+id/ivReviewImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gym" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/gym_card_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gym_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvReviewEntityName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Iron Paradise Gym" />

                    <TextView
                        android:id="@+id/tvReviewCategoryType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/gym_accent"
                        android:textSize="13sp"
                        tools:text="Gym &amp; Fitness • Bokaro" />

                    <TextView
                        android:id="@+id/tvReviewPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/gym_gold"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="₹199 / session" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/gym_card_border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description &amp; Bio"
                        android:textColor="@color/text_gray_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_white_crisp"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        tools:text="Premium gym equipped with international heavy weights, cardio decks, and certified trainers." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Owner / Partner Contact Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewOwnerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/gym_card_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gym_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Partner &amp; Contact Details"
                        android:textColor="@color/gym_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        tools:text="Owner: Rajesh Sharma" />

                    <TextView
                        android:id="@+id/tvReviewOwnerEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_gray_blue"
                        android:textSize="13sp"
                        tools:text="Email: rajesh@example.com" />

                    <TextView
                        android:id="@+id/tvReviewOwnerPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_gray_blue"
                        android:textSize="13sp"
                        tools:text="Phone: +91 9876543210" />

                    <TextView
                        android:id="@+id/tvReviewFssai"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/gym_gold"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="FSSAI: 12345678901234" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location & Map Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReviewLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/gym_card_surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/gym_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textColor="@color/gym_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReviewAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/text_white_crisp"
                        android:textSize="13sp"
                        tools:text="City Center, Sector 4, Bokaro Steel City" />

                    <org.osmdroid.views.MapView
                        android:id="@+id/mapReviewPreview"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/bg_top_dark"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminReject"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Reject"
            android:textColor="@color/gym_red"
            app:cornerRadius="12dp"
            app:strokeColor="@color/gym_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminSuspend"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Suspend"
            android:textColor="@color/status_pending"
            app:cornerRadius="12dp"
            app:strokeColor="@color/status_pending" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdminApprove"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/gym_green"
            android:text="Approve"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
