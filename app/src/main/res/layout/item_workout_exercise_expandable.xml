<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardExercise"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#111827"
    app:cardCornerRadius="18dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1F2E3D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header / Collapsed Row -->
        <LinearLayout
            android:id="@+id/llExerciseHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:background="?android:attr/selectableItemBackground">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivExerciseThumb"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:src="@drawable/girl_dumbell"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExerciseName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incline Dumbbell Press"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSetsReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="3 sets × 10-12 reps • 60s rest"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTargetMuscles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Upper Chest, Triceps"
                    android:textColor="#36A8FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivExpandChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#00D4FF"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Quick Action Bar: Sets counter + Rest Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetCounter"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Set 0 / 3"
                android:textSize="12sp"
                android:textColor="#00D4FF"
                android:backgroundTint="#162536"
                app:strokeColor="#00D4FF"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestTimer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="⏱ Rest Timer"
                android:textSize="12sp"
                android:textColor="#E5E7EB"
                android:backgroundTint="#162536"
                app:strokeColor="#1F2E3D"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <CheckBox
                android:id="@+id/cbExerciseCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done"
                android:textColor="#10B981"
                android:buttonTint="#10B981" />
        </LinearLayout>

        <!-- Rest Timer Countdown Banner (Initially Hidden) -->
        <LinearLayout
            android:id="@+id/llTimerBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#0A2A38"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rest Timer: 60s remaining"
                android:textColor="#00D4FF"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnCancelTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKIP"
                android:textColor="#EF4444"
                android:textStyle="bold"
                android:textSize="12sp"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Expandable Details Container -->
        <LinearLayout
            android:id="@+id/llExpandableBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="#0C1420"
            android:visibility="gone">

            <!-- Equipment chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQUIRED EQUIPMENT"
                android:textColor="#6B7280"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgExerciseEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                app:chipSpacing="6dp" />

            <!-- How to perform / steps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOW TO PERFORM"
                android:textColor="#00D4FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingMultiplier="1.2"
                android:text="1. Set bench to 30-degree incline.\n2. Press dumbbells upward with controlled elbows.\n3. Lower with deep stretch."
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <!-- AI Coach Tips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI COACH TIP"
                android:textColor="#19F5B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCoachTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Focus on slow 2-second eccentrics for maximum muscle activation."
                android:textColor="#D1D5DB"
                android:textSize="12sp" />

            <!-- Common Mistakes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMON MISTAKES"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvCommonMistakes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.2"
                android:text="Flaring elbows too wide, arching lower back excessively."
                android:textColor="#D1D5DB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
