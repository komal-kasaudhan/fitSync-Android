<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#071018">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#374151" />

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0B1520"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/stat_notify_chat"
                app:tint="#00D4FF" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FitSync AI Coach ⚡"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time fitness &amp; nutrition guide"
                    android:textColor="#10B981"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#9CA3AF" />
    </RelativeLayout>

    <!-- Suggestion Chips Horizontal Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/llSuggestionChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What should I eat for protein? 🥗"
                android:textColor="#00D4FF"
                app:chipBackgroundColor="#0D1926"
                app:chipStrokeColor="#1A2E44"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModifyWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modify today's workout 🏋️"
                android:textColor="#10B981"
                app:chipBackgroundColor="#0D1926"
                app:chipStrokeColor="#1A2E44"
                app:chipStrokeWidth="1dp"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipKneePain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I have knee pain 🩺"
                android:textColor="#F59E0B"
                app:chipBackgroundColor="#0D1926"
                app:chipStrokeColor="#1A2E44"
                app:chipStrokeWidth="1dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAiChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Typing Indicator View -->
    <LinearLayout
        android:id="@+id/llTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="#00D4FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="AI Coach is thinking... 🧠✨"
            android:textColor="#00D4FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Error / Retry Banner -->
    <LinearLayout
        android:id="@+id/llErrorRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E1216"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Failed to get AI response."
            android:textColor="#F87171"
            android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryChat"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Retry"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:backgroundTint="#EF4444"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1520"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#162536"
            android:hint="Ask about diet, meals, or workout..."
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="#00D4FF"
            android:src="@android:drawable/ic_menu_send"
            app:tint="#071018" />
    </LinearLayout>

</LinearLayout>
