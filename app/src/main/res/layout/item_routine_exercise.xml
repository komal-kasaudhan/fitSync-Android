<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="10dp"
app:cardBackgroundColor="#111827"
app:cardCornerRadius="16dp"
app:strokeWidth="1dp"
app:strokeColor="#1F2E3D"
android:clickable="true"
android:focusable="true"
android:foreground="?android:attr/selectableItemBackground">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgExerciseThumb"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_mail"
        android:scaleType="centerCrop"
        android:background="#071018"
        android:padding="14dp"
        app:tint="#36A8FF"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"/>

    <!-- 📝 EXERCISE METADATA TEXT LAYER BLOCK -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/imgExerciseThumb"
        android:layout_toStartOf="@id/imgRoutineActionIndicator"
        android:layout_marginStart="14dp"
        android:layout_centerVertical="true">

        <TextView
            android:id="@+id/tvExerciseRoutineName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dumbbell Curl"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvExerciseRoutineSpecs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 × 12 Reps  •  60s Rest"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- 🎯 NAVIGATION INDICATOR ARROW OR PLAY CLICK NODE -->
    <ImageView
        android:id="@+id/imgRoutineActionIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_mail"
        app:tint="#00D4FF"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="4dp"/>

</RelativeLayout>
</com.google.android.material.card.MaterialCardView>